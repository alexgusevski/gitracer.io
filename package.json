{
  "name": "gitracer.io",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://gitracer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexgusevski/gitracer.io.git"
  },
  "bugs": {
    "url": "https://github.com/alexgusevski/gitracer.io/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "astro": "^7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.72.0"
  }
}
