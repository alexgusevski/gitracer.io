{
  "name": "gitracer.io",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://gitracer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexgusevski/gitracer.io.git"
  },
  "bugs": {
    "url": "https://github.com/alexgusevski/gitracer.io/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --env preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
