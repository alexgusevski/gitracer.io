---
import BaseLayout from '../layouts/BaseLayout.astro';
import LatestRaces from '../components/LatestRaces.astro';
import RaceBuilder from '../components/RaceBuilder.astro';
import RaceExperience from '../components/RaceExperience.astro';
import TopContributors from '../components/TopContributors.astro';
import { getLatestRaces, getTopContributors, getTopContributorYears, recordRaceView } from '../lib/db';
import { parseRaceSlug, raceSlug } from '../lib/handles';
import { parseRange } from '../lib/ranges';
import { loadRace, RaceLoadError } from '../lib/race';
import { clientIp, runtimeEnv } from '../lib/server';
import type { LatestRace, RaceData, TopContributor } from '../lib/types';

let handles: string[] = [];
let slug = '';
let data: RaceData | null = null;
let races: LatestRace[] = [];
let contributors: TopContributor[] = [];
const currentYear = new Date().getUTCFullYear();
const contributorRange = parseRange(Astro.url.searchParams.get('contributorsRange'), []);
let contributorYears = [currentYear, ...contributorRange.years];
let errorMessage = '';
try {
  handles = parseRaceSlug(Astro.params.race);
  slug = raceSlug(handles);
  if (Astro.params.race !== slug) return Astro.redirect(`/${slug}${Astro.url.search}`);
  const env = runtimeEnv();
  data = await loadRace({ db: env.DB, githubToken: env.GITHUB_TOKEN, rateLimitSecret: env.RATE_LIMIT_SECRET, handles, slug, rangeKey: Astro.url.searchParams.get('range'), clientIp: clientIp(Astro.request) });
  Astro.locals.cfContext.waitUntil(recordRaceView(env.DB, slug, handles).catch((error) => console.error('record_race_view_failed', error)));
  const [racesResult, contributorsResult, contributorYearsResult] = await Promise.allSettled([
    getLatestRaces(env.DB, 10),
    getTopContributors(env.DB, 10, contributorRange),
    getTopContributorYears(env.DB),
  ]);
  if (racesResult.status === 'fulfilled') races = racesResult.value;
  else console.error('latest_races_unavailable', racesResult.reason);
  if (contributorsResult.status === 'fulfilled') contributors = contributorsResult.value;
  else console.error('top_contributors_unavailable', contributorsResult.reason);
  if (contributorYearsResult.status === 'fulfilled') contributorYears.push(...contributorYearsResult.value);
  else console.error('top_contributor_years_unavailable', contributorYearsResult.reason);
  contributorYears = [...new Set(contributorYears)].sort((a, b) => b - a);
} catch (error) {
  Astro.response.status = error instanceof RaceLoadError || (error instanceof Error && 'status' in error) ? Number((error as { status: number }).status) : 500;
  errorMessage = error instanceof Error ? error.message : 'This race could not be loaded.';
}
const names = data?.racers.map((racer) => `@${racer.login}`).join(' vs ') ?? 'GitHub race';
const title = `${names} contribution race — GitRacer`;
const description = data ? `Compare ${names} across ${data.range.label}. Public GitHub contributions on one cumulative graph.` : errorMessage;
const image = new URL(`/og/${slug || 'default'}.png${data ? `?range=${encodeURIComponent(data.range.key)}` : ''}`, Astro.site).toString();
---

<BaseLayout title={title} description={description} image={image} noindex={!data} pageType="profile">
  {data ? (
    <>
      <div class="shell race-page"><RaceExperience data={data} /></div>
      <div class="shell new-matchup">
        <RaceBuilder initialHandles={data.racers.map((racer) => racer.login)} compact heading="Change the lineup" />
        <div class="race-page-tables">
          <LatestRaces races={races} />
          <TopContributors contributors={contributors} years={contributorYears} range={contributorRange} />
        </div>
      </div>
    </>
  ) : (
    <section class="shell error-page"><span class="error-code">{Astro.response.status}</span><h1>That race hit the gravel.</h1><p>{errorMessage}</p><a class="button button--primary" href="/">start a different race →</a></section>
  )}
</BaseLayout>
