---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityTables from '../components/ActivityTables.astro';
import RaceBuilder from '../components/RaceBuilder.astro';
import RaceExperience from '../components/RaceExperience.astro';
import { parseRaceSlug } from '../lib/handles';
import { contributorRange, latestRaces, raceData, snapshotSlugs, topContributors, trendingRaces } from '../lib/snapshot';

// Only the saved races are built. Any other slug gets the real 404 page.
export function getStaticPaths() {
  return snapshotSlugs().map((race) => ({ params: { race } }));
}

const slug = Astro.params.race;
const data = raceData(parseRaceSlug(slug));
const range = contributorRange();
const names = data.racers.map((racer) => `@${racer.login}`).join(' vs ');
const title = `${names} contribution race — GitRacer`;
const description = `Compare ${names} across ${data.range.label}. Public GitHub contributions on one cumulative graph.`;
const canonical = new URL(`/${data.slug}`, Astro.site).toString();
---

<BaseLayout title={title} description={description} canonical={canonical} pageType="profile">
  <div class="shell race-page"><RaceExperience data={data} /></div>
  <div class="shell new-matchup">
    <RaceBuilder initialHandles={data.racers.map((racer) => racer.login)} compact heading="Change the lineup" />
    <div class="race-page-tables">
      <ActivityTables races={latestRaces(10)} trendingRaces={trendingRaces(10)} contributors={topContributors(10)} years={range.years} range={range} />
    </div>
  </div>
</BaseLayout>
