---
import BaseLayout from '../layouts/BaseLayout.astro';
import RaceBuilder from '../components/RaceBuilder.astro';
import RaceExperience from '../components/RaceExperience.astro';
import ActivityTables from '../components/ActivityTables.astro';
import { contributorRange, latestRaces, raceData, SNAPSHOT_LABEL, topContributors, trendingRaces } from '../lib/snapshot';

const FEATURED_HANDLES = ['robj3d3', 'levelsio', 'marclou', 'alexgusevski', 'jackfriks'];
const featuredRace = raceData(FEATURED_HANDLES);
const range = contributorRange();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'GitRacer',
  url: 'https://gitracer.io',
  description: 'Compare public GitHub contribution histories on one shareable cumulative graph.',
};
---

<BaseLayout hideHeader>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <section class="home-battle-hero" aria-label="Featured GitHub contribution battle">
    <RaceExperience data={featuredRace} featured />
  </section>
  <section class="shell home-lineup-builder" aria-label="Create a GitHub contribution race">
    <RaceBuilder initialHandles={featuredRace.racers.map((racer) => racer.login)} compact heading="Change the lineup" />
  </section>
  <div class="shell home-content">
    <ActivityTables races={latestRaces(10)} trendingRaces={trendingRaces(10)} contributors={topContributors(10)} years={range.years} range={range} />
    <section class="how-strip">
      <span class="eyebrow">what gets counted?</span>
      <div><h2>Whatever GitHub puts in the squares.</h2><p>Commits, pull requests, issues, and reviews, combined exactly as GitHub reports them. Every race here is a saved result from {SNAPSHOT_LABEL}, built from public data with zero repository access.</p><a href="/how-it-works">read the methodology →</a></div>
    </section>
  </div>
</BaseLayout>
