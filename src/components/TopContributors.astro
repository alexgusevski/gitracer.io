---
import type { RangeDefinition, TopContributor } from '../lib/types';

interface Props {
  contributors: TopContributor[];
  years: number[];
  range: RangeDefinition;
}
const { contributors, years, range } = Astro.props;
const currentYear = new Date().getUTCFullYear();
const preservedParams = [...Astro.url.searchParams.entries()].filter(([name]) => name !== 'contributorsRange');
---

<section class="top-contributors" aria-labelledby="contributors-title">
  <div class="section-heading">
    <div>
      <span class="eyebrow">from cached race data</span>
      <h2 id="contributors-title">Top contributors</h2>
    </div>
    <div class="section-heading__tools">
      <span class="status-dot"><i></i> {range.label.toLowerCase()} totals cached so far</span>
      <form class="contributor-filter" method="get" data-contributor-filter>
        {preservedParams.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
        <label>
          <span>period</span>
          <select name="contributorsRange" aria-label="Top contributors period" data-contributor-range-select>
            <option value="last30" selected={range.key === 'last30'}>last 30 days</option>
            <option value="last365" selected={range.key === 'last365'}>last 365 days</option>
            {years.map((year) => <option value={`year:${year}`} selected={range.key === `year:${year}`}>{year === currentYear ? `${year} · this year` : year}</option>)}
            <option value="lifetime" selected={range.key === 'lifetime'}>lifetime</option>
          </select>
        </label>
        <button class="sr-only" type="submit">Apply period</button>
      </form>
    </div>
  </div>
  {contributors.length ? (
    <div class="contributor-table-wrap">
      <table class="contributor-table">
        <thead>
          <tr>
            <th scope="col">rank</th>
            <th scope="col">developer</th>
            <th scope="col">contributions</th>
            <th scope="col">years cached</th>
            <th scope="col"><span class="sr-only">open race</span></th>
          </tr>
        </thead>
        <tbody>
          {contributors.map((contributor, index) => (
            <tr>
              <td class="contributor-table__rank">{String(index + 1).padStart(2, '0')}</td>
              <td>
                <a class="contributor-table__person" href={`/${contributor.login}?range=${range.key}`} data-track="top_contributor_opened" data-profile-handle={contributor.login}>
                  <img src={`/avatar/${contributor.login}`} alt="" loading="lazy" width="38" height="38" />
                  <span><strong>{contributor.displayName || contributor.login}</strong><small>@{contributor.login}</small></span>
                </a>
              </td>
              <td class="contributor-table__total">{contributor.totalContributions.toLocaleString()}</td>
              <td class="contributor-table__years">{contributor.cachedYearCount.toLocaleString()}</td>
              <td><a class="contributor-table__arrow" href={`/${contributor.login}?range=${range.key}`} aria-label={`Open ${contributor.login}'s ${range.label.toLowerCase()} contribution history`}>↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="empty-state"><span>&gt;_</span><p>No cached contributions for {range.label.toLowerCase()} yet.</p></div>
  )}
</section>

<script>
  document.querySelectorAll('[data-contributor-filter]').forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';
    const select = form.querySelector('[data-contributor-range-select]');
    if (select instanceof HTMLSelectElement) select.addEventListener('change', () => form.requestSubmit());
  });
</script>
