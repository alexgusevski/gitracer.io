---
import type { TopContributor } from '../lib/types';

interface Props { contributors: TopContributor[] }
const { contributors } = Astro.props;
---

<section class="top-contributors" aria-labelledby="contributors-title">
  <div class="section-heading">
    <div>
      <span class="eyebrow">from cached race data</span>
      <h2 id="contributors-title">Top contributors</h2>
    </div>
    <span class="status-dot"><i></i> all-time totals cached so far</span>
  </div>
  {contributors.length ? (
    <div class="contributor-table-wrap">
      <table class="contributor-table">
        <thead>
          <tr>
            <th scope="col">rank</th>
            <th scope="col">developer</th>
            <th scope="col">contributions</th>
            <th scope="col">years cached</th>
            <th scope="col"><span class="sr-only">open race</span></th>
          </tr>
        </thead>
        <tbody>
          {contributors.map((contributor, index) => (
            <tr>
              <td class="contributor-table__rank">{String(index + 1).padStart(2, '0')}</td>
              <td>
                <a class="contributor-table__person" href={`/${contributor.login}?range=lifetime`} data-track="top_contributor_opened" data-profile-handle={contributor.login}>
                  <img src={`/avatar/${contributor.login}`} alt="" loading="lazy" width="38" height="38" />
                  <span><strong>{contributor.displayName || contributor.login}</strong><small>@{contributor.login}</small></span>
                </a>
              </td>
              <td class="contributor-table__total">{contributor.totalContributions.toLocaleString()}</td>
              <td class="contributor-table__years">{contributor.cachedYearCount.toLocaleString()}</td>
              <td><a class="contributor-table__arrow" href={`/${contributor.login}?range=lifetime`} aria-label={`Open ${contributor.login}'s contribution history`}>↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="empty-state"><span>&gt;_</span><p>Contributors will appear after race data has been cached.</p></div>
  )}
</section>
