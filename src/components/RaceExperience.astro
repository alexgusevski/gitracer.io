---
import type { RaceData } from '../lib/types';
import BattleGame from './BattleGame.astro';
import GitHubLink from './GitHubLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { personHref, SNAPSHOT_AT, SNAPSHOT_LABEL } from '../lib/snapshot';

interface Props {
  data: RaceData;
  featured?: boolean;
}
const { data, featured = false } = Astro.props;
const currentYear = SNAPSHOT_AT.getUTCFullYear();
const savedAt = SNAPSHOT_AT.toISOString();
const safeJson = JSON.stringify(data).replace(/</g, '\\u003c');
const rangeOptions = [
  { value: 'last30', label: 'last 30 days' },
  { value: 'last365', label: 'last 365 days' },
  ...data.availableYears.map((year) => ({ value: `year:${year}`, label: year === currentYear ? `${year} · this year` : String(year) })),
  { value: 'lifetime', label: 'lifetime' },
];
const leaderText = data.racers.length === 1
  ? `@${data.racers[0]?.login} made ${data.racers[0]?.total.toLocaleString()} contributions.`
  : data.leader?.tied
    ? `It's a tie at ${data.racers.find((racer) => racer.login === data.leader?.login)?.total.toLocaleString()} contributions.`
    : `@${data.leader?.login} is leading by ${data.leader?.lead.toLocaleString()} contributions.`;
---

<section class:list={['race-experience', { 'race-experience--featured': featured }]} data-race-experience data-slug={data.slug} data-share-path={featured ? `/${data.slug}` : ''}>
  <div class="race-titlebar">
    <div class="race-leading">
      <div class="race-summary">
        <span class="eyebrow">saved results · {SNAPSHOT_LABEL}</span>
        <h1 data-leader-copy>{leaderText}</h1>
        <p>Every racer starts at zero on <span data-range-start>{data.range.start}</span>. All public GitHub contribution types count.</p>
      </div>
      {featured && (
        <select class="featured-range-select" data-range-select aria-label="Race period">
          {rangeOptions.map((option) => <option value={option.value} selected={data.range.key === option.value}>{option.label}</option>)}
        </select>
      )}
    </div>
    {featured && (
      <a class="wordmark featured-wordmark" href="/" aria-label="GitRacer home">
        <span aria-hidden="true"><img src="/icon.svg" alt="" /></span><b>gitracer</b><i>.io</i>
      </a>
    )}
    <div class="race-actions">
      {featured && <div class="race-freshness"><span class="cache-light"></span><span>saved <time datetime={savedAt}>{SNAPSHOT_LABEL}</time></span></div>}
      <button class="button button--quiet race-mode-toggle" type="button" data-mode-toggle aria-pressed="true">
        <span class="race-mode-icon" data-battle-mode-icon aria-hidden="true" hidden>⚔</span>
        <span class="race-mode-icon" data-graph-mode-icon aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M2.5 15.5 6.8 11l3 2.4 6-7"/><path d="M14 6.4h2.2v2.3"/></svg>
        </span>
        <span data-mode-label>graph mode</span>
      </button>
      {!featured && (
        <button class="button button--quiet race-action-icon" type="button" data-share-race aria-label="Share race" title="Share race">
          <span data-share-icon aria-hidden="true">↗</span>
          <span data-share-copied-icon aria-hidden="true" hidden>✓</span>
        </button>
      )}
      <button class="button button--quiet race-action-icon" type="button" data-refresh-race aria-label="Refresh race data" title="Refresh race data" hidden={!data.canRefresh}>
        <span aria-hidden="true">↻</span>
      </button>
      {featured && <GitHubLink compact />}
      {featured && <ThemeToggle compact />}
    </div>
  </div>

  {!featured && (
    <div class="race-toolbar">
      <label>
        <span>period</span>
        <select data-range-select aria-label="Race period">
          {rangeOptions.map((option) => <option value={option.value} selected={data.range.key === option.value}>{option.label}</option>)}
        </select>
      </label>
      <div class="race-freshness"><span class="cache-light"></span><span>saved <time datetime={savedAt}>{SNAPSHOT_LABEL}</time></span></div>
    </div>
  )}

  <div data-graph-panel hidden>
    <div class="chart-shell" data-chart-shell aria-label={`Cumulative GitHub contributions for ${data.racers.map((racer) => racer.login).join(', ')}`}>
      <div class="chart-y-label">cumulative contributions</div>
      <svg class="race-chart" data-race-chart viewBox="0 0 1000 440" role="img"></svg>
      <span class="chart-watermark" aria-hidden="true">gitracer.io</span>
      <div class="chart-tooltip" data-chart-tooltip hidden></div>
    </div>
  </div>
  <div data-battle-panel><BattleGame data={data} embedded hero={featured} active /></div>
  <p class="chart-error" data-chart-error role="alert"></p>

  {!featured && (
    <>
      <div class="racer-grid" data-racer-grid>
        {data.racers.map((racer, index) => (
          <article class="racer-card" style={`--racer-color:${racer.color}`} data-racer-index={index}>
            <a class="racer-card__person" href={personHref(racer.login)} data-profile-handle={racer.login}>
              <img src={racer.avatarUrl} alt={`${racer.login}'s GitHub avatar`} width="56" height="56" />
              <span><strong>{racer.displayName || racer.login}</strong><small>@{racer.login} ↗</small></span>
            </a>
            <div class="racer-card__stats">
              <span><b data-stat="total">{racer.total.toLocaleString()}</b><small>contributions</small></span>
              <span><b data-stat="activeDays">{racer.activeDays.toLocaleString()}</b><small>active days</small></span>
              <span><b data-stat="longestStreak">{racer.longestStreak.toLocaleString()}</b><small>best streak</small></span>
            </div>
          </article>
        ))}
      </div>
      <div class="race-note"><span aria-hidden="true">i</span><p>GitHub’s graph combines commits, pull requests, issues, and reviews that GitHub counts as contributions. Private activity only appears if the profile owner chose to expose anonymized private contribution counts.</p></div>
    </>
  )}
  <script is:inline type="application/json" data-race-data set:html={safeJson}></script>
</section>

<script>
  // @ts-nocheck -- this is a progressively enhanced SVG renderer over build-time race JSON.
  const compactNumber = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
  const exactNumber = new Intl.NumberFormat('en');
  const dateLabel = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

  document.querySelectorAll('[data-race-experience]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const json = root.querySelector('[data-race-data]');
    const svg = root.querySelector('[data-race-chart]');
    const shell = root.querySelector('[data-chart-shell]');
    const tooltip = root.querySelector('[data-chart-tooltip]');
    const select = root.querySelector('[data-range-select]');
    const graphPanel = root.querySelector('[data-graph-panel]');
    const battlePanel = root.querySelector('[data-battle-panel]');
    const modeButton = root.querySelector('[data-mode-toggle]');
    let state = JSON.parse(json?.textContent || '{}');
    let viewMode = 'battle';
    let chartRenderId = 0;
    const chartInstanceId = Math.random().toString(36).slice(2);
    if (!(svg instanceof SVGElement) || !(shell instanceof HTMLElement) || !(tooltip instanceof HTMLElement)) return;

    const esc = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    const cumulative = (days) => {
      let total = 0;
      return days.map((day) => (total += day.count));
    };
    const pathFor = (values, max, dims) => {
      const points = [`${dims.left},${dims.bottom}`];
      values.forEach((value, index) => {
        const x = dims.left + ((index + 1) / Math.max(1, values.length)) * dims.width;
        const y = dims.top + (1 - value / max) * dims.height;
        points.push(`${x.toFixed(2)},${y.toFixed(2)}`);
      });
      return `M${points.join(' L')}`;
    };
    const renderChart = () => {
      const legendColumns = 6;
      const legendRows = Math.ceil(state.racers.length / legendColumns);
      const chartTop = 24 + Math.max(0, legendRows - 1) * 20;
      const dims = { left: 76, right: 24, top: chartTop, bottom: 384, width: 900, height: 384 - chartTop };
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const clipLeft = dims.left - 6;
      const clipWidth = dims.width + 12;
      const clipId = `chart-reveal-${chartInstanceId}-${++chartRenderId}`;
      const series = state.racers.map((racer) => cumulative(racer.days));
      const rawMax = Math.max(1, ...series.flat());
      const magnitude = 10 ** Math.floor(Math.log10(rawMax));
      const step = Math.max(1, Math.ceil(rawMax / magnitude / 4) * magnitude);
      const max = step * 4;
      const grid = Array.from({ length: 5 }, (_, index) => {
        const value = step * (4 - index);
        const y = dims.top + (index / 4) * dims.height;
        return `<g><line class="chart-grid" x1="${dims.left}" x2="${dims.left + dims.width}" y1="${y}" y2="${y}"/><text class="chart-axis-label" x="${dims.left - 14}" y="${y + 4}" text-anchor="end">${compactNumber.format(value)}</text></g>`;
      }).join('');
      const dateIndexes = [...new Set([0, .25, .5, .75, 1].map((part) => Math.max(0, Math.min(state.racers[0].days.length - 1, Math.round((state.racers[0].days.length - 1) * part)))))];
      const dates = dateIndexes.map((index, position) => {
        const x = dims.left + ((index + 1) / Math.max(1, state.racers[0].days.length)) * dims.width;
        const date = state.racers[0].days[index]?.date ?? state.range.start;
        const anchor = position === 0 ? 'start' : position === dateIndexes.length - 1 ? 'end' : 'middle';
        return `<text class="chart-axis-label chart-date-label" x="${x}" y="${dims.bottom + 38}" text-anchor="${anchor}">${esc(dateLabel.format(new Date(`${date}T00:00:00Z`)))}</text>`;
      }).join('');
      const paths = state.racers.map((racer, index) => `<path class="chart-line" data-line="${index}" d="${pathFor(series[index], max, dims)}" style="--line-color:${racer.color}"/><circle class="chart-end" cx="${dims.left + dims.width}" cy="${dims.top + (1 - (series[index].at(-1) || 0) / max) * dims.height}" r="4.5" fill="${racer.color}"/>`).join('');
      const legend = state.racers.map((racer, index) => {
        const label = racer.login.length > 17 ? `${racer.login.slice(0, 16)}…` : racer.login;
        const x = dims.left + (index % legendColumns) * 150;
        const y = 11 + Math.floor(index / legendColumns) * 20;
        return `<g transform="translate(${x}, ${y})"><circle r="4" fill="${racer.color}"/><text class="chart-legend" x="9" y="4">@${esc(label)}</text></g>`;
      }).join('');
      svg.innerHTML = `<title>Cumulative public GitHub contributions from ${esc(state.range.start)} to ${esc(state.range.end)}</title><defs><clipPath id="${clipId}" clipPathUnits="userSpaceOnUse"><rect data-chart-reveal x="${clipLeft}" y="0" width="${reducedMotion ? clipWidth : 0}" height="440"/></clipPath></defs>${grid}${dates}<g data-chart-series clip-path="url(#${clipId})">${paths}</g>${legend}<line class="chart-crosshair" data-crosshair y1="${dims.top}" y2="${dims.bottom}" hidden/><rect data-chart-hit x="${dims.left}" y="${dims.top}" width="${dims.width}" height="${dims.height}" fill="transparent"/>`;
      if (!reducedMotion) {
        const reveal = svg.querySelector('[data-chart-reveal]');
        const startedAt = performance.now();
        const draw = (now) => {
          const progress = Math.max(0, Math.min(1, (now - startedAt) / 950));
          const eased = 1 - Math.pow(1 - progress, 3);
          reveal?.setAttribute('width', String(clipWidth * eased));
          if (progress < 1) requestAnimationFrame(draw);
          else reveal?.setAttribute('width', String(clipWidth));
        };
        requestAnimationFrame(draw);
      }
    };
    // Period changes and refreshes need the backend, which is offline: explain instead of fetching.
    const showOffline = (trigger) => window.gitracerOffline?.(trigger);

    svg.addEventListener('pointermove', (event) => {
      const rect = svg.getBoundingClientRect();
      const xSvg = ((event.clientX - rect.left) / rect.width) * 1000;
      const ratio = Math.max(0, Math.min(1, (xSvg - 76) / 900));
      const count = state.racers[0].days.length;
      const index = Math.max(0, Math.min(count - 1, Math.floor(ratio * count)));
      const x = 76 + ((index + 1) / Math.max(1, count)) * 900;
      const crosshair = svg.querySelector('[data-crosshair]');
      if (crosshair) { crosshair.removeAttribute('hidden'); crosshair.setAttribute('x1', String(x)); crosshair.setAttribute('x2', String(x)); }
      const date = state.racers[0].days[index].date;
      tooltip.innerHTML = `<b>${esc(dateLabel.format(new Date(`${date}T00:00:00Z`)))}</b>${state.racers.map((racer) => { const total = racer.days.slice(0, index + 1).reduce((sum, day) => sum + day.count, 0); return `<span><i style="background:${racer.color}"></i>@${esc(racer.login)} <strong>${exactNumber.format(total)}</strong><small>+${exactNumber.format(racer.days[index].count)}</small></span>`; }).join('')}`;
      tooltip.hidden = false;
      const localX = (x / 1000) * rect.width;
      tooltip.style.left = `${Math.max(12, Math.min(rect.width - tooltip.offsetWidth - 12, localX + 12))}px`;
      tooltip.style.top = `${Math.max(12, ((event.clientY - rect.top) / rect.height) * shell.clientHeight - tooltip.offsetHeight - 12)}px`;
    });
    svg.addEventListener('pointerleave', () => {
      tooltip.hidden = true;
      svg.querySelector('[data-crosshair]')?.setAttribute('hidden', '');
    });
    if (select instanceof HTMLSelectElement) select.addEventListener('change', () => {
      select.value = state.range.key;
      showOffline(select);
    });
    modeButton?.addEventListener('click', () => {
      viewMode = viewMode === 'graph' ? 'battle' : 'graph';
      if (graphPanel instanceof HTMLElement) graphPanel.hidden = viewMode !== 'graph';
      if (battlePanel instanceof HTMLElement) battlePanel.hidden = viewMode !== 'battle';
      const battleIcon = modeButton.querySelector('[data-battle-mode-icon]');
      const graphIcon = modeButton.querySelector('[data-graph-mode-icon]');
      const label = modeButton.querySelector('[data-mode-label]');
      if (battleIcon instanceof HTMLElement) battleIcon.hidden = viewMode === 'battle';
      if (graphIcon instanceof HTMLElement) graphIcon.hidden = viewMode !== 'battle';
      if (label) label.textContent = viewMode === 'battle' ? 'graph mode' : 'battle mode';
      modeButton.setAttribute('aria-pressed', String(viewMode === 'battle'));
      if (viewMode === 'battle') window.dispatchEvent(new CustomEvent('gitracer:battle-activate', { detail: { slug: root.dataset.slug, data: state } }));
    });
    root.querySelector('[data-refresh-race]')?.addEventListener('click', (event) => showOffline(event.currentTarget));
    root.querySelector('[data-share-race]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const shareUrl = new URL(root.dataset.sharePath || location.pathname, location.origin);
      try {
        if (navigator.share) await navigator.share({ title: document.title, text: root.querySelector('[data-leader-copy]')?.textContent || '', url: shareUrl.href });
        else if (button instanceof HTMLButtonElement) {
          await navigator.clipboard.writeText(shareUrl.href);
          const shareIcon = button.querySelector('[data-share-icon]');
          const copiedIcon = button.querySelector('[data-share-copied-icon]');
          if (shareIcon instanceof HTMLElement) shareIcon.hidden = true;
          if (copiedIcon instanceof HTMLElement) copiedIcon.hidden = false;
          button.ariaLabel = 'Race link copied';
          window.setTimeout(() => {
            if (shareIcon instanceof HTMLElement) shareIcon.hidden = false;
            if (copiedIcon instanceof HTMLElement) copiedIcon.hidden = true;
            button.ariaLabel = 'Share race';
          }, 1600);
        }
      } catch {}
    });
    renderChart();
  });
</script>
