---
import { BATTLE_PRESETS } from '../lib/battle';
---

<div class="battle-lab" data-battle-lab>
  <header class="lab-header">
    <a class="lab-brand" href="https://gitracer.io" aria-label="Open GitRacer" rel="noreferrer">
      <span aria-hidden="true"><img src="/icon.svg" alt="" /></span>
      <b>gitracer</b><i>.io</i><em>/ battle lab</em>
    </a>
    <div class="lab-state"><span></span> local prototype · synthetic data</div>
    <a class="exit-link" href="https://gitracer.io" rel="noreferrer">production site ↗</a>
  </header>

  <main class="lab-main">
    <section class="lab-intro">
      <div>
        <span class="kicker">experiment 01 / contribution combat</span>
        <h1>Commit battle</h1>
        <p>Every day drops reinforcements. Every contribution adds battle strength. Last army standing wins.</p>
      </div>
      <div class="scenario-control">
        <label for="battle-scenario">test data</label>
        <select id="battle-scenario" data-scenario-select>
          {BATTLE_PRESETS.map((preset) => <option value={preset.id}>{preset.label} — {preset.description}</option>)}
        </select>
        <button type="button" data-remix>remix seed</button>
      </div>
    </section>

    <section class="battle-readout" aria-label="Battle status">
      <div><span>sim date</span><strong data-date>—</strong></div>
      <div><span>timeline</span><strong data-day>day — / —</strong></div>
      <div><span>fighters live</span><strong data-active>0</strong></div>
      <div><span>render scale</span><strong data-scale>1 dot = 1 contribution</strong></div>
      <div><span>input total</span><strong data-total>0</strong></div>
    </section>

    <section class="battle-layout">
      <div class="arena-panel">
        <div class="arena-labels" aria-hidden="true"><span>battle simulation</span><span data-phase>WAITING</span></div>
        <canvas data-battle-canvas width="1280" height="720" role="img" aria-label="Top-down contributor battle simulation"></canvas>
        <div class="base-hud-layer" data-base-hud-layer aria-hidden="true"></div>
        <div class="start-card" data-start-card>
          <span>READY</span>
          <strong>Daily commits are loaded.</strong>
          <small>Press run to start the 30 second timeline.</small>
        </div>
        <div class="winner-card" data-winner-card hidden>
          <span>SIMULATION COMPLETE</span>
          <strong data-winner>—</strong>
          <small data-winner-detail>—</small>
        </div>
      </div>

      <aside class="team-panel">
        <div class="panel-heading"><span>processes</span><small>alive / queued / K</small></div>
        <div class="team-list" data-team-list></div>
        <div class="rules-note">
          <b>rules.v0</b>
          <p>Equal fighters. Nearest target. Break a 100 HP base and that contributor stops spawning.</p>
        </div>
      </aside>
    </section>

    <section class="playback-panel">
      <button class="run-button" type="button" data-play><span>▶</span> run simulation</button>
      <button type="button" data-restart>↺ restart</button>
      <div class="speed-control" aria-label="Playback speed">
        <span>speed</span>
        <button type="button" data-speed="0.5">0.5×</button>
        <button type="button" data-speed="1" aria-pressed="true">1×</button>
        <button type="button" data-speed="2">2×</button>
        <button type="button" data-speed="4">4×</button>
      </div>
      <div class="timeline-track"><span data-progress></span></div>
      <div class="engine-state"><span data-fps>60 fps</span><i>·</i><span>webgl2 batch</span><i>·</i><span>fixed 60hz</span></div>
    </section>

    <p class="keyboard-note">space = play/pause <i>·</i> r = restart <i>·</i> exact contribution totals are never discarded</p>
    <p class="sr-only" aria-live="polite" data-live-status></p>
  </main>
</div>

<script>
  import { BattleSimulation, createBattleScenario, type BattleHudState } from '../lib/battle';
  import { BattleRenderer } from '../lib/battle-renderer';

  const integer = new Intl.NumberFormat('en');

  document.querySelectorAll('[data-battle-lab]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const canvas = root.querySelector('[data-battle-canvas]');
    const scenarioSelect = root.querySelector('[data-scenario-select]');
    const playButton = root.querySelector('[data-play]');
    const teamList = root.querySelector('[data-team-list]');
    const baseHudLayer = root.querySelector('[data-base-hud-layer]');
    if (!(canvas instanceof HTMLCanvasElement) || !(scenarioSelect instanceof HTMLSelectElement) || !(playButton instanceof HTMLButtonElement) || !(teamList instanceof HTMLElement)) return;

    let seed = 1;
    let speed = 1;
    let paused = true;
    let accumulator = 0;
    let previousTime = performance.now();
    let lastHudPaint = 0;
    let frameCount = 0;
    let fpsStartedAt = performance.now();
    let fps = 60;
    let simulation = new BattleSimulation(createBattleScenario(scenarioSelect.value, seed), seed);
    const renderer = new BattleRenderer(canvas, simulation);

    const query = (selector: string): Element | null => root.querySelector(selector);
    const setText = (selector: string, value: string) => {
      const element = query(selector);
      if (element) element.textContent = value;
    };

    const makeTeamRows = () => {
      teamList.replaceChildren();
      simulation.teams.forEach((team, index) => {
        const row = document.createElement('div');
        row.className = 'team-row';
        row.dataset.team = String(index);
        row.style.setProperty('--team', team.contributor.color);
        const identity = document.createElement('div');
        identity.className = 'team-identity';
        const avatar = document.createElement('img');
        avatar.className = 'team-avatar';
        avatar.src = team.contributor.avatarUrl;
        avatar.alt = '';
        avatar.width = 24;
        avatar.height = 24;
        avatar.referrerPolicy = 'no-referrer';
        const label = document.createElement('span');
        const login = document.createElement('b');
        const commits = document.createElement('small');
        login.textContent = `@${team.contributor.login}`;
        commits.dataset.teamCommits = '';
        label.appendChild(login);
        label.appendChild(commits);
        identity.appendChild(avatar);
        identity.appendChild(label);
        const stats = document.createElement('strong');
        stats.dataset.teamStats = '';
        const bar = document.createElement('div');
        bar.className = 'team-bar';
        const fill = document.createElement('span');
        fill.dataset.teamBar = '';
        bar.appendChild(fill);
        row.appendChild(identity);
        row.appendChild(stats);
        row.appendChild(bar);
        teamList.appendChild(row);
      });
    };

    const makeBaseHuds = () => {
      if (!(baseHudLayer instanceof HTMLElement)) return;
      baseHudLayer.replaceChildren();
      simulation.teams.forEach((team, index) => {
        const hud = document.createElement('div');
        hud.className = 'base-hud';
        hud.dataset.baseHud = String(index);
        hud.style.left = `${(team.base.x / 1280) * 100}%`;
        hud.style.top = `${(team.base.y / 720) * 100}%`;
        hud.style.setProperty('--team', team.contributor.color);
        const handle = document.createElement('b');
        handle.textContent = `@${team.contributor.login}`;
        const profile = document.createElement('span');
        profile.className = 'base-profile';
        const avatar = document.createElement('img');
        avatar.src = team.contributor.avatarUrl;
        avatar.alt = '';
        avatar.referrerPolicy = 'no-referrer';
        const deathMarker = document.createElement('i');
        deathMarker.textContent = '🕊️';
        profile.appendChild(avatar);
        profile.appendChild(deathMarker);
        const graph = document.createElement('canvas');
        graph.className = 'base-history';
        graph.dataset.baseHistory = '';
        graph.width = 106;
        graph.height = 38;
        const hp = document.createElement('div');
        hp.className = 'base-hp';
        const hpFill = document.createElement('span');
        hpFill.dataset.baseHpFill = '';
        hp.appendChild(hpFill);
        const hpLabel = document.createElement('small');
        hpLabel.dataset.baseHpLabel = '';
        hud.appendChild(handle);
        hud.appendChild(profile);
        hud.appendChild(graph);
        hud.appendChild(hp);
        hud.appendChild(hpLabel);
        baseHudLayer.appendChild(hud);
      });
    };

    const paintBaseHuds = (state: BattleHudState) => {
      const styles = getComputedStyle(root);
      const emptyColor = styles.getPropertyValue('--line').trim() || '#d1d9e0';
      state.teams.forEach((team, index) => {
        const hud = baseHudLayer?.querySelector(`[data-base-hud="${index}"]`);
        if (!(hud instanceof HTMLElement)) return;
        hud.classList.toggle('is-dead', team.baseHp <= 0);
        const fill = hud.querySelector('[data-base-hp-fill]');
        const label = hud.querySelector('[data-base-hp-label]');
        if (fill instanceof HTMLElement) fill.style.width = `${team.baseHp}%`;
        if (label) label.textContent = team.baseHp > 0 ? `${team.baseHp} HP` : 'DEAD';
        const graph = hud.querySelector('[data-base-history]');
        if (!(graph instanceof HTMLCanvasElement)) return;
        const context = graph.getContext('2d');
        if (!context) return;
        const counts = team.contributor.days.map((day) => day.count);
        const peak = Math.max(1, ...counts);
        const columns = Math.max(1, Math.ceil(counts.length / 7));
        const stepX = Math.min(5, 102 / columns);
        const cellWidth = Math.max(1, stepX - 0.65);
        context.clearRect(0, 0, graph.width, graph.height);
        counts.forEach((count, day) => {
          const column = Math.floor(day / 7);
          const row = day % 7;
          context.globalAlpha = day <= state.dayIndex ? 0.25 + (count / peak) * 0.75 : 0.38;
          context.fillStyle = day <= state.dayIndex ? team.contributor.color : emptyColor;
          context.fillRect(2 + column * stepX, 3 + row * 4.55, cellWidth, 3.75);
        });
        context.globalAlpha = 1;
      });
    };

    const paintHud = (now: number, force = false) => {
      if (!force && now - lastHudPaint < 90) return;
      lastHudPaint = now;
      const state = simulation.getHudState();
      setText('[data-date]', state.date || '—');
      setText('[data-day]', `day ${state.dayIndex + 1} / ${state.dayCount}`);
      setText('[data-active]', integer.format(state.activeFighters));
      setText('[data-scale]', `1 dot = ${integer.format(state.unitScale)} contribution${state.unitScale === 1 ? '' : 's'}`);
      setText('[data-total]', integer.format(state.totalContributions));
      paintBaseHuds(state);
      setText('[data-phase]', state.phase === 'running' ? (paused ? 'PAUSED' : 'RUNNING') : state.phase.toUpperCase());
      const progress = query('[data-progress]');
      if (progress instanceof HTMLElement) progress.style.width = `${state.progress * 100}%`;

      const ranking = [...state.teams].sort((a, b) => (b.alive + b.pending) - (a.alive + a.pending));
      state.teams.forEach((team, index) => {
        const row = teamList.querySelector(`[data-team="${index}"]`);
        if (!(row instanceof HTMLElement)) return;
        row.style.order = String(ranking.indexOf(team));
        const total = team.contributor.days.reduce((sum, day) => sum + day.count, 0);
        const commits = row.querySelector('[data-team-commits]');
        const stats = row.querySelector('[data-team-stats]');
        const bar = row.querySelector('[data-team-bar]');
        if (commits) commits.textContent = `${integer.format(team.contributionsSeen)} / ${integer.format(total)} commits`;
        if (stats) stats.textContent = `${team.alive} / ${team.pending} / ${team.kills}`;
        if (bar instanceof HTMLElement) bar.style.width = `${total ? (team.contributionsSeen / total) * 100 : 0}%`;
      });

      const winnerCard = query('[data-winner-card]');
      if (winnerCard instanceof HTMLElement) winnerCard.hidden = state.phase !== 'finished';
      if (state.phase === 'finished' && state.winnerTeam !== null) {
        const winner = state.teams[state.winnerTeam];
        if (winner) {
          setText('[data-winner]', `@${winner.contributor.login} wins`);
          setText('[data-winner-detail]', `${integer.format(winner.kills)} eliminations · ${integer.format(winner.alive + winner.pending)} strength left`);
          setText('[data-live-status]', `Simulation complete. ${winner.contributor.login} wins.`);
        }
        paused = true;
        paintPlayButton();
      }
    };

    const paintPlayButton = () => {
      playButton.innerHTML = paused ? '<span>▶</span> run simulation' : '<span>Ⅱ</span> pause simulation';
      playButton.setAttribute('aria-pressed', String(!paused));
    };

    const reset = (incrementSeed = false) => {
      if (incrementSeed) seed += 1;
      simulation = new BattleSimulation(createBattleScenario(scenarioSelect.value, seed), seed);
      renderer.setSimulation(simulation);
      paused = true;
      accumulator = 0;
      const startCard = query('[data-start-card]');
      const winnerCard = query('[data-winner-card]');
      if (startCard instanceof HTMLElement) startCard.hidden = false;
      if (winnerCard instanceof HTMLElement) winnerCard.hidden = true;
      makeBaseHuds();
      makeTeamRows();
      paintPlayButton();
      paintHud(performance.now(), true);
      renderer.draw();
    };

    const togglePlayback = () => {
      if (simulation.isFinished) reset(false);
      paused = !paused;
      const startCard = query('[data-start-card]');
      if (startCard instanceof HTMLElement) startCard.hidden = true;
      paintPlayButton();
      paintHud(performance.now(), true);
    };

    const frame = (now: number) => {
      const wallDelta = Math.min(0.1, (now - previousTime) / 1000);
      previousTime = now;
      if (!paused) {
        accumulator = Math.min(0.25, accumulator + wallDelta * speed);
        while (accumulator >= 1 / 60) {
          simulation.step(1 / 60);
          accumulator -= 1 / 60;
        }
      }
      renderer.draw();
      paintHud(now);

      frameCount += 1;
      if (now - fpsStartedAt >= 600) {
        fps = Math.round((frameCount * 1000) / (now - fpsStartedAt));
        frameCount = 0;
        fpsStartedAt = now;
        setText('[data-fps]', `${fps} fps`);
      }
      requestAnimationFrame(frame);
    };

    playButton.addEventListener('click', togglePlayback);
    query('[data-restart]')?.addEventListener('click', () => reset(false));
    query('[data-remix]')?.addEventListener('click', () => reset(true));
    scenarioSelect.addEventListener('change', () => reset(false));
    root.querySelectorAll('[data-speed]').forEach((button) => button.addEventListener('click', () => {
      speed = Number(button.getAttribute('data-speed')) || 1;
      root.querySelectorAll('[data-speed]').forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
    }));
    document.addEventListener('keydown', (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLSelectElement) return;
      if (event.code === 'Space') {
        event.preventDefault();
        togglePlayback();
      }
      if (event.key.toLowerCase() === 'r') reset(false);
    });
    window.addEventListener('resize', () => renderer.resize());

    reset(false);
    requestAnimationFrame(frame);
  });
</script>

<style>
  :global(html) { background: var(--paper); }
  :global(body) { min-width: 320px; background: var(--paper); color: var(--ink); font-family: var(--mono); }
  :global(button), :global(select) { color: inherit; }
  .battle-lab { min-height: 100vh; border-top: 3px solid var(--race); background: var(--paper); color: var(--ink); }
  .lab-header { min-height: 66px; padding: 0 22px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); background: var(--panel); }
  .lab-brand { width: max-content; display: flex; align-items: center; gap: 3px; font-size: 15px; }
  .lab-brand > span { width: 30px; height: 30px; margin-right: 7px; display: grid; place-items: center; border-radius: 7px; box-shadow: var(--shadow); overflow: hidden; }
  .lab-brand img { width: 100%; height: 100%; }
  .lab-brand b { font-weight: 750; }
  .lab-brand i { color: var(--green); font-style: normal; font-weight: 700; }
  .lab-brand em { margin-left: 7px; color: var(--muted); font-size: 10px; font-style: normal; font-weight: 500; }
  .lab-state { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 9px; letter-spacing: .09em; text-transform: uppercase; }
  .lab-state span { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 12%, transparent); }
  .exit-link { justify-self: end; color: var(--muted); font-size: 10px; }
  .exit-link:hover { color: var(--ink); }
  .lab-main { width: min(1500px, calc(100% - 32px)); margin: 0 auto; padding: 34px 0 28px; }
  .lab-intro { display: flex; align-items: end; justify-content: space-between; gap: 28px; }
  .kicker { color: var(--green); font-size: 9px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  h1 { margin: 5px 0 4px; font-family: var(--display); font-size: clamp(33px, 5vw, 54px); line-height: 1; letter-spacing: -.055em; }
  .lab-intro p { margin: 0; color: var(--muted); font-size: 11px; }
  .scenario-control { min-width: min(460px, 100%); display: grid; grid-template-columns: 1fr auto; gap: 6px; }
  .scenario-control label { grid-column: 1 / -1; color: var(--muted); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
  select, button { min-height: 38px; border: 1px solid var(--line-strong); border-radius: 7px; background: var(--panel); font-size: 10px; cursor: pointer; box-shadow: var(--shadow); }
  select { min-width: 0; padding: 0 34px 0 10px; }
  button { padding: 0 13px; }
  button:hover { border-color: var(--ink); background: var(--paper-2); }
  button:focus-visible, select:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .battle-readout { margin-top: 26px; display: grid; grid-template-columns: .85fr .85fr .85fr 1.45fr 1fr; border: 1px solid var(--line-strong); border-bottom: 0; border-radius: 9px 9px 0 0; background: var(--panel); overflow: hidden; }
  .battle-readout > div { min-width: 0; padding: 9px 12px; border-right: 1px solid var(--line); }
  .battle-readout > div:last-child { border-right: 0; }
  .battle-readout span, .battle-readout strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .battle-readout span { color: var(--muted); font-size: 8px; letter-spacing: .12em; text-transform: uppercase; }
  .battle-readout strong { margin-top: 2px; font-size: 11px; font-weight: 650; }
  .battle-layout { display: grid; grid-template-columns: minmax(0, 1fr) 274px; border: 1px solid var(--line-strong); background: var(--panel); box-shadow: var(--shadow); }
  .arena-panel { position: relative; min-width: 0; overflow: hidden; border-right: 1px solid var(--line); background: var(--paper-2); }
  .arena-labels { height: 30px; padding: 0 11px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: var(--panel); color: var(--muted); font-size: 8px; letter-spacing: .11em; text-transform: uppercase; }
  .arena-labels span:last-child { color: var(--green); }
  canvas { position: relative; z-index: 1; width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; background: var(--paper-2); }
  .base-hud-layer { position: absolute; z-index: 2; top: 30px; right: 0; left: 0; aspect-ratio: 16 / 9; pointer-events: none; }
  .base-hud-layer :global(.base-hud) { position: absolute; width: 160px; display: grid; grid-template-columns: 46px 106px; grid-template-rows: auto 46px 8px auto; align-items: center; gap: 3px 8px; transform: translate(-23px, -50%); }
  .base-hud-layer :global(.base-hud > b) { grid-column: 1 / -1; overflow: hidden; color: var(--ink); font-size: 7px; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .base-hud-layer :global(.base-profile) { grid-column: 1; grid-row: 2; width: 44px; height: 44px; display: grid; place-items: center; border: 2px solid var(--team); border-radius: 50%; overflow: hidden; background: var(--panel); box-shadow: 2px 2px 0 color-mix(in srgb, var(--ink) 14%, transparent); }
  .base-hud-layer :global(.base-profile img) { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .base-hud-layer :global(.base-profile i) { grid-area: 1 / 1; display: none; font-size: 27px; font-style: normal; line-height: 1; }
  .base-hud-layer :global(.base-history) { grid-column: 2; grid-row: 2; width: 106px; height: 38px; background: transparent; aspect-ratio: auto; }
  .base-hud-layer :global(.base-hp) { position: relative; grid-column: 1 / -1; grid-row: 3; width: 126px; height: 8px; justify-self: center; overflow: hidden; background: #d73535; }
  .base-hud-layer :global(.base-hp span) { display: block; width: 100%; height: 100%; background: #9be332; transition: width .12s linear; }
  .base-hud-layer :global(.base-hud > small) { grid-column: 1 / -1; grid-row: 4; color: var(--muted); font-size: 6px; line-height: 1; text-align: center; }
  .base-hud-layer :global(.base-hud.is-dead) { filter: grayscale(.75); }
  .base-hud-layer :global(.base-hud.is-dead .base-profile img) { display: none; }
  .base-hud-layer :global(.base-hud.is-dead .base-profile i) { display: block; }
  .base-hud-layer :global(.base-hud.is-dead .base-history) { opacity: .32; }
  .start-card, .winner-card { position: absolute; z-index: 3; top: 50%; left: 50%; width: min(320px, calc(100% - 40px)); padding: 18px; border: 1px solid var(--line-strong); border-top: 3px solid var(--green); border-radius: 8px; background: color-mix(in srgb, var(--panel) 94%, transparent); box-shadow: var(--shadow); transform: translate(-50%, -45%); text-align: center; backdrop-filter: blur(4px); }
  .start-card span, .winner-card span { display: block; color: var(--green); font-size: 8px; letter-spacing: .15em; }
  .start-card strong, .winner-card strong { display: block; margin-top: 6px; font-family: var(--display); font-size: 20px; }
  .start-card small, .winner-card small { display: block; margin-top: 5px; color: var(--muted); font-size: 9px; }
  .team-panel { min-width: 0; display: flex; flex-direction: column; background: var(--panel); }
  .panel-heading { min-height: 30px; padding: 0 10px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 8px; letter-spacing: .11em; text-transform: uppercase; }
  .panel-heading small { font: inherit; }
  .team-list { display: flex; flex-direction: column; }
  .team-list :global(.team-row) { position: relative; min-height: 61px; padding: 9px 10px 11px; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; border-bottom: 1px solid var(--line); transition: background .12s ease; }
  .team-list :global(.team-row:hover) { background: var(--paper-2); }
  .team-list :global(.team-identity) { min-width: 0; display: flex; align-items: center; gap: 8px; }
  .team-list :global(.team-avatar) { width: 24px; height: 24px; flex: 0 0 auto; border: 2px solid var(--team); border-radius: 50%; background: var(--paper-2); object-fit: cover; image-rendering: pixelated; }
  .team-list :global(.team-identity span) { min-width: 0; }
  .team-list :global(.team-identity b), .team-list :global(.team-identity small) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
