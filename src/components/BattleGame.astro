---
import { createBattleScenario, createBattleScenarioFromRace } from '../lib/battle';
import type { RaceData } from '../lib/types';

interface Props {
  data?: RaceData;
  embedded?: boolean;
  hero?: boolean;
  active?: boolean;
}

const { data, embedded = false, hero = false, active = !data } = Astro.props;
const scenario = data ? createBattleScenarioFromRace(data) : createBattleScenario('garage', 1);
const safeScenario = JSON.stringify(scenario).replace(/</g, '\\u003c');
---

<div
  class:list={['battle-arena', { 'battle-arena--embedded': embedded, 'battle-arena--hero': hero }]}
  data-battle-arena
  data-race-slug={data?.slug ?? ''}
  data-range-key={data?.range.key ?? ''}
  data-autostart={active ? 'true' : 'false'}
>
  <div class="battle-field">
    <canvas data-battle-canvas width="1280" height="720" role="img" aria-label="Top-down contributor battle simulation"></canvas>
    <div class="base-hud-layer" data-base-hud-layer></div>
    <span class="battle-watermark" aria-hidden="true">gitracer.io</span>
    <div class="winner-card" data-winner-card hidden>
      <span class="winner-trophy" aria-hidden="true">🏆</span>
      <img data-winner-avatar alt="" width="58" height="58" />
      <div>
        <small>SIMULATION COMPLETE</small>
        <strong data-winner>—</strong>
        <span data-winner-detail>—</span>
      </div>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-live-status></p>
  <script is:inline type="application/json" data-battle-scenario set:html={safeScenario}></script>
</div>

<script>
  // @ts-nocheck -- this client-only renderer consumes server-validated race JSON and custom mode events.
  import { BATTLE_HEIGHT, BATTLE_WIDTH, BattleSimulation, calculateBattleViewScale, calculateContributionGridLayout, createBattleScenarioFromRace, type BattleHudState, type BattleScenario } from '../lib/battle';
  import { BattleRenderer } from '../lib/battle-renderer';
  import { MAX_RACERS, normalizeHandle } from '../lib/handles';

  const exactNumber = new Intl.NumberFormat('en');
  const levelKeys = ['NONE', 'FIRST_QUARTILE', 'SECOND_QUARTILE', 'THIRD_QUARTILE', 'FOURTH_QUARTILE'];

  document.querySelectorAll('[data-battle-arena]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const canvas = root.querySelector('[data-battle-canvas]');
    const battleField = root.querySelector('.battle-field');
    const scenarioJson = root.querySelector('[data-battle-scenario]');
    const baseHudLayer = root.querySelector('[data-base-hud-layer]');
    if (!(canvas instanceof HTMLCanvasElement) || !(battleField instanceof HTMLElement) || !(baseHudLayer instanceof HTMLElement)) return;

    let scenario = JSON.parse(scenarioJson?.textContent || '{}') as BattleScenario;
    let simulation = new BattleSimulation(scenario, 1);
    let renderer: BattleRenderer;
    try {
      renderer = new BattleRenderer(canvas, simulation);
    } catch {
      root.classList.add('is-unavailable');
      const live = root.querySelector('[data-live-status]');
      if (live) live.textContent = 'This browser cannot render the battle simulation.';
      return;
    }

    let active = root.dataset.autostart === 'true';
    let framePending = false;
    let accumulator = 0;
    let previousTime = performance.now();
    let lastHudPaint = 0;
    const graphLayouts = new WeakMap();

    const scenarioSignature = (value: BattleScenario) => {
      let hash = 2166136261;
      for (const contributor of value.contributors) {
        for (const day of contributor.days) {
          hash ^= day.count;
          hash = Math.imul(hash, 16777619);
          hash ^= levelKeys.indexOf(day.level || 'NONE');
          hash = Math.imul(hash, 16777619);
        }
      }
      return `${value.id}:${value.contributors.length}:${value.contributors[0]?.days.length ?? 0}:${hash >>> 0}`;
    };
    let currentSignature = scenarioSignature(scenario);

    const contributionPalette = () => {
      const styles = getComputedStyle(root);
      return {
        NONE: styles.getPropertyValue('--contribution-none').trim(),
        FIRST_QUARTILE: styles.getPropertyValue('--contribution-one').trim(),
        SECOND_QUARTILE: styles.getPropertyValue('--contribution-two').trim(),
        THIRD_QUARTILE: styles.getPropertyValue('--contribution-three').trim(),
        FOURTH_QUARTILE: styles.getPropertyValue('--contribution-four').trim(),
      };
    };

    const fallbackLevel = (count: number) => {
      if (count <= 0) return 'NONE';
      if (count <= 3) return 'FIRST_QUARTILE';
      if (count <= 7) return 'SECOND_QUARTILE';
      if (count <= 12) return 'THIRD_QUARTILE';
      return 'FOURTH_QUARTILE';
    };

    const positionHud = (hud: HTMLElement, base: { x: number; y: number }) => {
      const viewScale = calculateBattleViewScale(battleField.clientWidth, battleField.clientHeight);
      const x = 0.5 + (base.x / BATTLE_WIDTH - 0.5) * viewScale.x;
      const y = 0.5 + (base.y / BATTLE_HEIGHT - 0.5) * viewScale.y;
      hud.style.left = `${x * 100}%`;
      hud.style.top = `${y * 100}%`;
      hud.classList.toggle('is-right', base.x > 760);
    };

    const repositionBaseHuds = () => {
      simulation.teams.forEach((team, index) => {
        const hud = baseHudLayer.querySelector(`[data-base-hud="${index}"]`);
        if (hud instanceof HTMLElement) positionHud(hud, team.base);
      });
      const emptyHud = baseHudLayer.querySelector('.base-hud--empty');
      if (emptyHud instanceof HTMLElement) positionHud(emptyHud, simulation.emptySeat);
    };

    const makeBaseHuds = () => {
      baseHudLayer.replaceChildren();
      simulation.teams.forEach((team, index) => {
        const hud = document.createElement('div');
        hud.className = 'base-hud';
        hud.dataset.baseHud = String(index);
        positionHud(hud, team.base);
        hud.style.setProperty('--team', team.contributor.color);

        const handle = document.createElement('b');
        handle.textContent = `@${team.contributor.login}`;
        const profile = document.createElement('button');
        profile.type = 'button';
        profile.className = 'base-profile';
        profile.dataset.removeToggle = team.contributor.login;
        profile.setAttribute('aria-label', `Remove ${team.contributor.login} from this race`);
        profile.setAttribute('aria-expanded', 'false');
        const avatar = document.createElement('img');
        avatar.src = team.contributor.avatarUrl;
        avatar.alt = `${team.contributor.login}'s GitHub avatar`;
        avatar.referrerPolicy = 'no-referrer';
        const deathMarker = document.createElement('i');
        deathMarker.setAttribute('aria-hidden', 'true');
        deathMarker.textContent = '🕊️';
        profile.append(avatar, deathMarker);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'base-remove';
        remove.dataset.removeContributor = team.contributor.login;
        remove.textContent = 'Remove?';
        remove.hidden = true;

        const graph = document.createElement('canvas');
        graph.className = 'base-history';
        graph.dataset.baseHistory = '';
        const days = team.contributor.days;
        const firstWeekday = days[0] ? new Date(`${days[0].date}T00:00:00Z`).getUTCDay() : 0;
        const layout = calculateContributionGridLayout(days.length, firstWeekday);
        const pixelRatio = Math.min(2, window.devicePixelRatio || 1);
        graph.width = Math.ceil(layout.width * pixelRatio);
        graph.height = Math.ceil(layout.height * pixelRatio);
        graph.style.width = `${layout.width}px`;
        graph.style.height = `${layout.height}px`;
        hud.style.setProperty('--history-width', `${layout.width}px`);
        graphLayouts.set(graph, { ...layout, firstWeekday, pixelRatio });

        const hp = document.createElement('div');
        hp.className = 'base-hp';
        const hpFill = document.createElement('span');
        hpFill.dataset.baseHpFill = '';
        hp.appendChild(hpFill);
        const hpLabel = document.createElement('small');
        hpLabel.dataset.baseHpLabel = '';
        hud.append(handle, profile, graph, hp, hpLabel, remove);
        baseHudLayer.appendChild(hud);
      });

      if (!root.dataset.raceSlug) return;
      const emptyHud = document.createElement('div');
      emptyHud.className = 'base-hud base-hud--empty';
      positionHud(emptyHud, simulation.emptySeat);

      const emptyLabel = document.createElement('b');
      emptyLabel.textContent = 'add racer';
      const addSeat = document.createElement('button');
      addSeat.type = 'button';
      addSeat.className = 'base-profile base-profile--empty';
      addSeat.dataset.addSeat = '';
      addSeat.setAttribute('aria-label', 'Add a GitHub user to this race');
      addSeat.setAttribute('aria-expanded', 'false');
      addSeat.textContent = '+';

      const addForm = document.createElement('form');
      addForm.className = 'base-add-form';
      addForm.dataset.addForm = '';
      addForm.noValidate = true;
      addForm.autocomplete = 'off';
      addForm.setAttribute('data-1p-ignore', 'true');
      addForm.setAttribute('data-lpignore', 'true');
      addForm.setAttribute('data-bwignore', 'true');
      addForm.setAttribute('data-protonpass-ignore', 'true');
      addForm.setAttribute('data-form-type', 'other');
      addForm.hidden = true;
      const addPlaceholder = document.createElement('span');
      addPlaceholder.className = 'base-add-placeholder';
      addPlaceholder.textContent = 'github handle';
      addPlaceholder.setAttribute('aria-hidden', 'true');
      const addInput = document.createElement('div');
      addInput.dataset.addInput = '';
      addInput.contentEditable = 'plaintext-only';
      addInput.tabIndex = 0;
      addInput.setAttribute('role', 'textbox');
      addInput.setAttribute('aria-label', 'GitHub username to add');
      addInput.setAttribute('aria-multiline', 'false');
      addInput.setAttribute('aria-autocomplete', 'none');
      addInput.setAttribute('inputmode', 'text');
      addInput.setAttribute('enterkeyhint', 'go');
      addInput.setAttribute('autocapitalize', 'none');
      addInput.setAttribute('autocorrect', 'off');
      addInput.setAttribute('data-1p-ignore', 'true');
      addInput.setAttribute('data-lpignore', 'true');
      addInput.setAttribute('data-bwignore', 'true');
      addInput.setAttribute('data-protonpass-ignore', 'true');
      addInput.setAttribute('data-form-type', 'other');
      addInput.spellcheck = false;
      const syncPlaceholder = () => {
        addPlaceholder.hidden = Boolean((addInput.textContent || '').trim());
      };
      addInput.addEventListener('input', syncPlaceholder);
      const addSubmit = document.createElement('button');
      addSubmit.type = 'submit';
      addSubmit.setAttribute('aria-label', 'Add racer');
      addSubmit.title = 'Add racer';
      addSubmit.textContent = '↵';
      const addError = document.createElement('small');
      addError.dataset.addError = '';
      addError.setAttribute('role', 'alert');
      addForm.append(addPlaceholder, addInput, addSubmit, addError);
      emptyHud.append(emptyLabel, addSeat, addForm);
      baseHudLayer.appendChild(emptyHud);
    };

    const paintBaseHuds = (state: BattleHudState) => {
      const palette = contributionPalette();
      state.teams.forEach((team, index) => {
        const hud = baseHudLayer.querySelector(`[data-base-hud="${index}"]`);
        if (!(hud instanceof HTMLElement)) return;
        hud.classList.toggle('is-dead', team.baseHp <= 0);
        const fill = hud.querySelector('[data-base-hp-fill]');
        const label = hud.querySelector('[data-base-hp-label]');
        if (fill instanceof HTMLElement) fill.style.width = `${team.baseHp}%`;
        if (label) label.textContent = team.baseHp > 0 ? `${team.baseHp} HP` : 'OUT';

        const graph = hud.querySelector('[data-base-history]');
        if (!(graph instanceof HTMLCanvasElement)) return;
        const context = graph.getContext('2d');
        if (!context) return;
        const days = team.contributor.days;
        const layout = graphLayouts.get(graph);
        if (!layout) return;
        context.setTransform(layout.pixelRatio, 0, 0, layout.pixelRatio, 0, 0);
        context.clearRect(0, 0, layout.width, layout.height);
        days.forEach((day, dayIndex) => {
          const position = layout.firstWeekday + dayIndex;
          const week = Math.floor(position / 7);
          const band = Math.floor(week / layout.columnsPerBand);
          const column = week % layout.columnsPerBand;
          const row = position % 7;
          const x = column * layout.step;
          const y = band * (7 * layout.step + layout.bandGap) + row * layout.step;
          const level = dayIndex <= state.dayIndex ? (day.level || fallbackLevel(day.count)) : 'NONE';
          context.fillStyle = palette[level] || palette.NONE;
          context.beginPath();
          context.roundRect(x, y, layout.cellSize, layout.cellSize, layout.cornerRadius);
          context.fill();
        });
      });
    };

    const paintHud = (now: number, force = false) => {
      if (!force && now - lastHudPaint < 90) return;
      lastHudPaint = now;
      const state = simulation.getHudState();
      paintBaseHuds(state);
      const winnerCard = root.querySelector('[data-winner-card]');
      if (winnerCard instanceof HTMLElement) winnerCard.hidden = state.phase !== 'finished';
      if (state.phase !== 'finished' || state.winnerTeam === null) return;
      const winner = state.teams[state.winnerTeam];
      if (!winner) return;
      const avatar = root.querySelector('[data-winner-avatar]');
      const winnerText = root.querySelector('[data-winner]');
      const detail = root.querySelector('[data-winner-detail]');
      const live = root.querySelector('[data-live-status]');
      if (avatar instanceof HTMLImageElement) avatar.src = winner.contributor.avatarUrl;
      if (winnerText) winnerText.textContent = `@${winner.contributor.login} wins`;
      if (detail) detail.textContent = `${exactNumber.format(winner.kills)} eliminations · ${exactNumber.format(winner.alive)} still standing`;
      if (live) live.textContent = `Simulation complete. ${winner.contributor.login} wins.`;
    };

    const frame = (now: number) => {
      framePending = false;
      const wallDelta = Math.min(0.1, (now - previousTime) / 1000);
      previousTime = now;
      const wasFinished = simulation.isFinished;
      if (active && !simulation.isFinished) {
        accumulator = Math.min(0.25, accumulator + wallDelta);
        while (accumulator >= 1 / 60) {
          simulation.step(1 / 60);
          accumulator -= 1 / 60;
        }
      }
      renderer.draw();
      paintHud(now, !wasFinished && simulation.isFinished);
      if (active && !simulation.isFinished) {
        framePending = true;
        requestAnimationFrame(frame);
      }
    };

    const start = () => {
      active = true;
      if (framePending || simulation.isFinished) return;
      previousTime = performance.now();
      framePending = true;
      requestAnimationFrame(frame);
    };

    const replaceScenario = (nextScenario: BattleScenario) => {
      const nextSignature = scenarioSignature(nextScenario);
      if (nextSignature === currentSignature) return;
      scenario = nextScenario;
      currentSignature = nextSignature;
      simulation = new BattleSimulation(scenario, 1);
      renderer.setSimulation(simulation);
      accumulator = 0;
      const winnerCard = root.querySelector('[data-winner-card]');
      if (winnerCard instanceof HTMLElement) winnerCard.hidden = true;
      makeBaseHuds();
      paintHud(performance.now(), true);
      renderer.draw();
    };

    const closeLineupControls = () => {
      baseHudLayer.querySelectorAll('[data-remove-contributor]').forEach((button) => {
        if (button instanceof HTMLButtonElement) button.hidden = true;
      });
      baseHudLayer.querySelectorAll('[data-remove-toggle]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
      const form = baseHudLayer.querySelector('[data-add-form]');
      const addSeat = baseHudLayer.querySelector('[data-add-seat]');
      if (form instanceof HTMLFormElement) form.hidden = true;
      if (addSeat) addSeat.setAttribute('aria-expanded', 'false');
      form?.closest('.base-hud')?.classList.remove('is-editing');
    };

    const navigateToLineup = (handles: string[]) => {
      if (!handles.length) {
        window.location.assign('/');
        return;
      }
      const destination = new URL(`/${handles.join('+')}`, window.location.origin);
      if (root.dataset.rangeKey) destination.searchParams.set('range', root.dataset.rangeKey);
      window.location.assign(`${destination.pathname}${destination.search}`);
    };

    baseHudLayer.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const addSeat = target.closest('[data-add-seat]');
      if (addSeat instanceof HTMLButtonElement) {
        const form = addSeat.closest('.base-hud')?.querySelector('[data-add-form]');
        const opening = form instanceof HTMLFormElement && form.hidden;
        closeLineupControls();
        if (form instanceof HTMLFormElement && opening) {
          form.hidden = false;
          addSeat.setAttribute('aria-expanded', 'true');
          form.closest('.base-hud')?.classList.add('is-editing');
          const error = form.querySelector('[data-add-error]');
          if (error) error.textContent = scenario.contributors.length >= MAX_RACERS ? `This race already has ${MAX_RACERS} people.` : '';
          if (scenario.contributors.length < MAX_RACERS) window.setTimeout(() => form.querySelector('[data-add-input]')?.focus(), 0);
        }
        return;
      }

      const removeToggle = target.closest('[data-remove-toggle]');
      if (removeToggle instanceof HTMLButtonElement) {
        const remove = removeToggle.closest('.base-hud')?.querySelector('[data-remove-contributor]');
        const opening = remove instanceof HTMLButtonElement && remove.hidden;
        closeLineupControls();
        if (remove instanceof HTMLButtonElement && opening) {
          remove.hidden = false;
          removeToggle.setAttribute('aria-expanded', 'true');
          remove.focus();
        }
        return;
      }

      const remove = target.closest('[data-remove-contributor]');
      if (!(remove instanceof HTMLButtonElement)) return;
      const login = remove.dataset.removeContributor;
      const handles = scenario.contributors.map((contributor) => contributor.login).filter((handle) => handle !== login);
      window.posthog?.capture?.('race_participant_removed', { racer_count: handles.length + 1 });
      navigateToLineup(handles);
    });

    baseHudLayer.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.matches('[data-add-form]')) return;
      event.preventDefault();
      const input = form.querySelector('[data-add-input]');
      const error = form.querySelector('[data-add-error]');
      if (!(input instanceof HTMLElement)) return;
      const handle = normalizeHandle(input.textContent || '');
      const handles = scenario.contributors.map((contributor) => contributor.login);
      if (error) error.textContent = '';
      if (handles.length >= MAX_RACERS) {
        if (error) error.textContent = `This race already has ${MAX_RACERS} people.`;
        return;
      }
      if (!handle) {
        if (error) error.textContent = 'Enter a valid GitHub handle.';
        input.focus();
        return;
      }
      if (handles.includes(handle)) {
        if (error) error.textContent = `@${handle} is already racing.`;
        input.focus();
        return;
      }
      window.posthog?.capture?.('race_participant_added', { racer_count: handles.length + 1 });
      navigateToLineup([...handles, handle]);
    });

    baseHudLayer.addEventListener('keydown', (event) => {
      const target = event.target;
      if (event.key === 'Enter' && target instanceof HTMLElement && target.matches('[data-add-input]')) {
        event.preventDefault();
        target.closest('form')?.requestSubmit();
        return;
      }
      if (event.key !== 'Escape') return;
      closeLineupControls();
      const addSeat = baseHudLayer.querySelector('[data-add-seat]');
      if (addSeat instanceof HTMLButtonElement) addSeat.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-remove-toggle], [data-remove-contributor], [data-add-seat], [data-add-form]')) return;
      closeLineupControls();
    });

    const matchesEvent = (event: Event) => {
      const detail = (event as CustomEvent).detail;
      return detail?.slug === root.dataset.raceSlug && detail?.data?.racers;
    };
    window.addEventListener('gitracer:battle-data', (event) => {
      if (!matchesEvent(event)) return;
      const data = (event as CustomEvent).detail.data;
      root.dataset.rangeKey = data.range.key;
      replaceScenario(createBattleScenarioFromRace(data));
      if (active) start();
    });
    window.addEventListener('gitracer:battle-activate', (event) => {
      if (!matchesEvent(event)) return;
      const data = (event as CustomEvent).detail.data;
      root.dataset.rangeKey = data.range.key;
      replaceScenario(createBattleScenarioFromRace(data));
      start();
    });
    window.addEventListener('resize', () => {
      renderer.resize();
      repositionBaseHuds();
      renderer.draw();
    });
    new MutationObserver(() => paintBaseHuds(simulation.getHudState())).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    makeBaseHuds();
    paintHud(performance.now(), true);
    renderer.draw();
    if (active) start();
  });
</script>

<style>
  .battle-arena {
    --battle-zoom: 1.18;
    --contribution-none: #ebedf0;
    --contribution-one: #9be9a8;
    --contribution-two: #40c463;
    --contribution-three: #30a14e;
    --contribution-four: #216e39;
    width: 100%;
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--mono);
    overflow: hidden;
  }
  .battle-arena:not(.battle-arena--embedded) { min-height: 100vh; display: grid; align-items: center; }
  .battle-arena--embedded { border: 1px solid var(--line-strong); border-radius: 0 0 10px 10px; box-shadow: var(--shadow); }
  .battle-arena--hero { height: 100%; min-height: 0; border: 0; border-radius: 0; box-shadow: none; }
  .battle-field { position: relative; width: 100%; overflow: hidden; background: var(--paper-2); }
  .battle-field > canvas { position: relative; z-index: 1; width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; background: var(--paper-2); transform: scale(var(--battle-zoom)); transform-origin: center; }
  .battle-arena--hero .battle-field,
  .battle-arena--hero .battle-field > canvas { height: 100%; }
  .battle-arena--hero .battle-field > canvas { aspect-ratio: auto; }
  .battle-arena--hero .battle-watermark { display: none; }
  .base-hud-layer { position: absolute; z-index: 2; inset: 0; aspect-ratio: 16 / 9; pointer-events: none; transform: scale(var(--battle-zoom)); transform-origin: center; }
  .battle-arena--hero .base-hud-layer { aspect-ratio: auto; }
  .base-hud-layer :global(.base-hud) { --history-width: 40px; position: absolute; width: calc(68px + var(--history-width)); display: grid; grid-template-columns: 56px var(--history-width); grid-template-rows: auto minmax(56px, auto) 8px auto; align-items: center; gap: 4px 10px; transform: translate(-28px, -50%); }
  .base-hud-layer :global(.base-hud.is-right) { grid-template-columns: var(--history-width) 56px; transform: translate(calc(-100% + 28px), -50%); }
  .base-hud-layer :global(.base-hud > b) { grid-column: 1 / -1; overflow: hidden; color: var(--ink); font-size: 9px; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .base-hud-layer :global(.base-hud.is-right > b) { text-align: right; }
  .base-hud-layer :global(.base-profile) { grid-column: 1; grid-row: 2; width: 54px; height: 54px; padding: 0; display: grid; place-items: center; border: 2px solid var(--team); border-radius: 50%; overflow: hidden; background: var(--panel); color: var(--ink); box-shadow: 2px 2px 0 color-mix(in srgb, var(--ink) 14%, transparent); cursor: pointer; pointer-events: auto; transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease; }
  .base-hud-layer :global(.base-profile:hover) { transform: scale(1.05); box-shadow: 3px 3px 0 color-mix(in srgb, var(--ink) 18%, transparent); }
  .base-hud-layer :global(.base-profile:focus-visible),
  .base-hud-layer :global(.base-remove:focus-visible),
