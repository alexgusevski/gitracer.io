---
import { createBattleScenario, createBattleScenarioFromRace } from '../lib/battle';
import type { RaceData } from '../lib/types';

interface Props {
  data?: RaceData;
  embedded?: boolean;
}

const { data, embedded = false } = Astro.props;
const scenario = data ? createBattleScenarioFromRace(data) : createBattleScenario('garage', 1);
const safeScenario = JSON.stringify(scenario).replace(/</g, '\\u003c');
---

<div
  class:list={['battle-arena', { 'battle-arena--embedded': embedded }]}
  data-battle-arena
  data-race-slug={data?.slug ?? ''}
  data-autostart={data ? 'false' : 'true'}
>
  <div class="battle-field">
    <canvas data-battle-canvas width="1280" height="720" role="img" aria-label="Top-down contributor battle simulation"></canvas>
    <div class="base-hud-layer" data-base-hud-layer aria-hidden="true"></div>
    <span class="battle-watermark" aria-hidden="true">gitracer.io</span>
    <div class="winner-card" data-winner-card hidden>
      <span class="winner-trophy" aria-hidden="true">🏆</span>
      <img data-winner-avatar alt="" width="58" height="58" />
      <div>
        <small>SIMULATION COMPLETE</small>
        <strong data-winner>—</strong>
        <span data-winner-detail>—</span>
      </div>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-live-status></p>
  <script is:inline type="application/json" data-battle-scenario set:html={safeScenario}></script>
</div>

<script>
  // @ts-nocheck -- this client-only renderer consumes server-validated race JSON and custom mode events.
  import { BattleSimulation, calculateContributionGridLayout, createBattleScenarioFromRace, type BattleHudState, type BattleScenario } from '../lib/battle';
  import { BattleRenderer } from '../lib/battle-renderer';

  const exactNumber = new Intl.NumberFormat('en');
  const levelKeys = ['NONE', 'FIRST_QUARTILE', 'SECOND_QUARTILE', 'THIRD_QUARTILE', 'FOURTH_QUARTILE'];

  document.querySelectorAll('[data-battle-arena]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const canvas = root.querySelector('[data-battle-canvas]');
    const scenarioJson = root.querySelector('[data-battle-scenario]');
    const baseHudLayer = root.querySelector('[data-base-hud-layer]');
    if (!(canvas instanceof HTMLCanvasElement) || !(baseHudLayer instanceof HTMLElement)) return;

    let scenario = JSON.parse(scenarioJson?.textContent || '{}') as BattleScenario;
    let simulation = new BattleSimulation(scenario, 1);
    let renderer: BattleRenderer;
    try {
      renderer = new BattleRenderer(canvas, simulation);
    } catch {
      root.classList.add('is-unavailable');
      const live = root.querySelector('[data-live-status]');
      if (live) live.textContent = 'This browser cannot render the battle simulation.';
      return;
    }

    let active = root.dataset.autostart === 'true';
    let framePending = false;
    let accumulator = 0;
    let previousTime = performance.now();
    let lastHudPaint = 0;
    const graphLayouts = new WeakMap();

    const scenarioSignature = (value: BattleScenario) => {
      let hash = 2166136261;
      for (const contributor of value.contributors) {
        for (const day of contributor.days) {
          hash ^= day.count;
          hash = Math.imul(hash, 16777619);
          hash ^= levelKeys.indexOf(day.level || 'NONE');
          hash = Math.imul(hash, 16777619);
        }
      }
      return `${value.id}:${value.contributors.length}:${value.contributors[0]?.days.length ?? 0}:${hash >>> 0}`;
    };
    let currentSignature = scenarioSignature(scenario);

    const contributionPalette = () => {
      const styles = getComputedStyle(root);
      return {
        NONE: styles.getPropertyValue('--contribution-none').trim(),
        FIRST_QUARTILE: styles.getPropertyValue('--contribution-one').trim(),
        SECOND_QUARTILE: styles.getPropertyValue('--contribution-two').trim(),
        THIRD_QUARTILE: styles.getPropertyValue('--contribution-three').trim(),
        FOURTH_QUARTILE: styles.getPropertyValue('--contribution-four').trim(),
      };
    };

    const fallbackLevel = (count: number) => {
      if (count <= 0) return 'NONE';
      if (count <= 3) return 'FIRST_QUARTILE';
      if (count <= 7) return 'SECOND_QUARTILE';
      if (count <= 12) return 'THIRD_QUARTILE';
      return 'FOURTH_QUARTILE';
    };

    const makeBaseHuds = () => {
      baseHudLayer.replaceChildren();
      simulation.teams.forEach((team, index) => {
        const hud = document.createElement('div');
        hud.className = 'base-hud';
        hud.dataset.baseHud = String(index);
        hud.style.left = `${(team.base.x / 1280) * 100}%`;
        hud.style.top = `${(team.base.y / 720) * 100}%`;
        hud.style.setProperty('--team', team.contributor.color);
        hud.classList.toggle('is-right', team.base.x > 760);

        const handle = document.createElement('b');
        handle.textContent = `@${team.contributor.login}`;
        const profile = document.createElement('span');
        profile.className = 'base-profile';
        const avatar = document.createElement('img');
        avatar.src = team.contributor.avatarUrl;
        avatar.alt = '';
        avatar.referrerPolicy = 'no-referrer';
        const deathMarker = document.createElement('i');
        deathMarker.textContent = '🕊️';
        profile.append(avatar, deathMarker);

        const graph = document.createElement('canvas');
        graph.className = 'base-history';
        graph.dataset.baseHistory = '';
        const days = team.contributor.days;
        const firstWeekday = days[0] ? new Date(`${days[0].date}T00:00:00Z`).getUTCDay() : 0;
        const layout = calculateContributionGridLayout(days.length, firstWeekday);
        const pixelRatio = Math.min(2, window.devicePixelRatio || 1);
        graph.width = Math.ceil(layout.width * pixelRatio);
        graph.height = Math.ceil(layout.height * pixelRatio);
        graph.style.width = `${layout.width}px`;
        graph.style.height = `${layout.height}px`;
        hud.style.setProperty('--history-width', `${layout.width}px`);
        graphLayouts.set(graph, { ...layout, firstWeekday, pixelRatio });

        const hp = document.createElement('div');
        hp.className = 'base-hp';
        const hpFill = document.createElement('span');
        hpFill.dataset.baseHpFill = '';
        hp.appendChild(hpFill);
        const hpLabel = document.createElement('small');
        hpLabel.dataset.baseHpLabel = '';
        hud.append(handle, profile, graph, hp, hpLabel);
        baseHudLayer.appendChild(hud);
      });
    };

    const paintBaseHuds = (state: BattleHudState) => {
      const palette = contributionPalette();
      state.teams.forEach((team, index) => {
        const hud = baseHudLayer.querySelector(`[data-base-hud="${index}"]`);
        if (!(hud instanceof HTMLElement)) return;
        hud.classList.toggle('is-dead', team.baseHp <= 0);
        const fill = hud.querySelector('[data-base-hp-fill]');
        const label = hud.querySelector('[data-base-hp-label]');
        if (fill instanceof HTMLElement) fill.style.width = `${team.baseHp}%`;
        if (label) label.textContent = team.baseHp > 0 ? `${team.baseHp} HP` : 'OUT';

        const graph = hud.querySelector('[data-base-history]');
        if (!(graph instanceof HTMLCanvasElement)) return;
        const context = graph.getContext('2d');
        if (!context) return;
        const days = team.contributor.days;
        const layout = graphLayouts.get(graph);
        if (!layout) return;
        context.setTransform(layout.pixelRatio, 0, 0, layout.pixelRatio, 0, 0);
        context.clearRect(0, 0, layout.width, layout.height);
        days.forEach((day, dayIndex) => {
          const position = layout.firstWeekday + dayIndex;
          const week = Math.floor(position / 7);
          const band = Math.floor(week / layout.columnsPerBand);
          const column = week % layout.columnsPerBand;
          const row = position % 7;
          const x = column * layout.step;
          const y = band * (7 * layout.step + layout.bandGap) + row * layout.step;
          const level = dayIndex <= state.dayIndex ? (day.level || fallbackLevel(day.count)) : 'NONE';
          context.fillStyle = palette[level] || palette.NONE;
          context.beginPath();
          context.roundRect(x, y, layout.cellSize, layout.cellSize, layout.cornerRadius);
          context.fill();
        });
      });
    };

    const paintHud = (now: number, force = false) => {
      if (!force && now - lastHudPaint < 90) return;
      lastHudPaint = now;
      const state = simulation.getHudState();
      paintBaseHuds(state);
      const winnerCard = root.querySelector('[data-winner-card]');
      if (winnerCard instanceof HTMLElement) winnerCard.hidden = state.phase !== 'finished';
      if (state.phase !== 'finished' || state.winnerTeam === null) return;
      const winner = state.teams[state.winnerTeam];
      if (!winner) return;
      const avatar = root.querySelector('[data-winner-avatar]');
      const winnerText = root.querySelector('[data-winner]');
      const detail = root.querySelector('[data-winner-detail]');
      const live = root.querySelector('[data-live-status]');
      if (avatar instanceof HTMLImageElement) avatar.src = winner.contributor.avatarUrl;
      if (winnerText) winnerText.textContent = `@${winner.contributor.login} wins`;
      if (detail) detail.textContent = `${exactNumber.format(winner.kills)} eliminations · ${exactNumber.format(winner.alive)} still standing`;
      if (live) live.textContent = `Simulation complete. ${winner.contributor.login} wins.`;
    };

    const frame = (now: number) => {
      framePending = false;
      const wallDelta = Math.min(0.1, (now - previousTime) / 1000);
      previousTime = now;
      if (active && !simulation.isFinished) {
        accumulator = Math.min(0.25, accumulator + wallDelta);
        while (accumulator >= 1 / 60) {
          simulation.step(1 / 60);
          accumulator -= 1 / 60;
        }
      }
      renderer.draw();
      paintHud(now);
      if (active && !simulation.isFinished) {
        framePending = true;
        requestAnimationFrame(frame);
      }
    };

    const start = () => {
      active = true;
      if (framePending || simulation.isFinished) return;
      previousTime = performance.now();
      framePending = true;
      requestAnimationFrame(frame);
    };

    const replaceScenario = (nextScenario: BattleScenario) => {
      const nextSignature = scenarioSignature(nextScenario);
      if (nextSignature === currentSignature) return;
      scenario = nextScenario;
      currentSignature = nextSignature;
      simulation = new BattleSimulation(scenario, 1);
      renderer.setSimulation(simulation);
      accumulator = 0;
      const winnerCard = root.querySelector('[data-winner-card]');
      if (winnerCard instanceof HTMLElement) winnerCard.hidden = true;
      makeBaseHuds();
      paintHud(performance.now(), true);
      renderer.draw();
    };

    const matchesEvent = (event: Event) => {
      const detail = (event as CustomEvent).detail;
      return detail?.slug === root.dataset.raceSlug && detail?.data?.racers;
    };
    window.addEventListener('gitracer:battle-data', (event) => {
      if (!matchesEvent(event)) return;
      replaceScenario(createBattleScenarioFromRace((event as CustomEvent).detail.data));
      if (active) start();
    });
    window.addEventListener('gitracer:battle-activate', (event) => {
      if (!matchesEvent(event)) return;
      replaceScenario(createBattleScenarioFromRace((event as CustomEvent).detail.data));
      start();
    });
    window.addEventListener('resize', () => {
      renderer.resize();
      renderer.draw();
    });
    new MutationObserver(() => paintBaseHuds(simulation.getHudState())).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    makeBaseHuds();
    paintHud(performance.now(), true);
    renderer.draw();
    if (active) start();
  });
</script>

<style>
  .battle-arena {
    --contribution-none: #ebedf0;
    --contribution-one: #9be9a8;
    --contribution-two: #40c463;
    --contribution-three: #30a14e;
    --contribution-four: #216e39;
    width: 100%;
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--mono);
    overflow: hidden;
  }
  .battle-arena:not(.battle-arena--embedded) { min-height: 100vh; display: grid; align-items: center; }
  .battle-arena--embedded { border: 1px solid var(--line-strong); border-radius: 0 0 10px 10px; box-shadow: var(--shadow); }
  .battle-field { position: relative; width: 100%; overflow: hidden; background: var(--paper-2); }
  .battle-field > canvas { position: relative; z-index: 1; width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; background: var(--paper-2); }
  .base-hud-layer { position: absolute; z-index: 2; inset: 0; aspect-ratio: 16 / 9; pointer-events: none; }
  .base-hud-layer :global(.base-hud) { --history-width: 40px; position: absolute; width: calc(54px + var(--history-width)); display: grid; grid-template-columns: 46px var(--history-width); grid-template-rows: auto minmax(46px, auto) 7px auto; align-items: center; gap: 3px 8px; transform: translate(-23px, -50%); }
  .base-hud-layer :global(.base-hud.is-right) { grid-template-columns: var(--history-width) 46px; transform: translate(calc(-100% + 23px), -50%); }
  .base-hud-layer :global(.base-hud > b) { grid-column: 1 / -1; overflow: hidden; color: var(--ink); font-size: 7px; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .base-hud-layer :global(.base-hud.is-right > b) { text-align: right; }
  .base-hud-layer :global(.base-profile) { grid-column: 1; grid-row: 2; width: 44px; height: 44px; display: grid; place-items: center; border: 2px solid var(--team); border-radius: 50%; overflow: hidden; background: var(--panel); box-shadow: 2px 2px 0 color-mix(in srgb, var(--ink) 14%, transparent); }
  .base-hud-layer :global(.base-profile img) { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .base-hud-layer :global(.base-profile i) { grid-area: 1 / 1; display: none; font-size: 27px; font-style: normal; line-height: 1; }
  .base-hud-layer :global(.base-history) { grid-column: 2; grid-row: 2; align-self: center; background: transparent; }
  .base-hud-layer :global(.base-hp) { grid-column: 1; grid-row: 3; width: 44px; height: 7px; justify-self: center; overflow: hidden; background: #d73535; }
  .base-hud-layer :global(.base-hp span) { display: block; width: 100%; height: 100%; background: #9be332; transition: width .12s linear; }
  .base-hud-layer :global(.base-hud > small) { grid-column: 1; grid-row: 4; color: var(--muted); font-size: 6px; line-height: 1; text-align: center; }
  .base-hud-layer :global(.base-hud.is-right .base-profile),
  .base-hud-layer :global(.base-hud.is-right .base-hp),
  .base-hud-layer :global(.base-hud.is-right > small) { grid-column: 2; }
  .base-hud-layer :global(.base-hud.is-right .base-history) { grid-column: 1; }
  .base-hud-layer :global(.base-hud.is-dead) { filter: grayscale(.75); }
  .base-hud-layer :global(.base-hud.is-dead .base-profile img) { display: none; }
  .base-hud-layer :global(.base-hud.is-dead .base-profile i) { display: block; }
  .base-hud-layer :global(.base-hud.is-dead .base-history) { opacity: .32; }
  .battle-watermark { position: absolute; z-index: 4; top: 16px; right: 18px; padding: 4px 7px; background: color-mix(in srgb, var(--panel) 88%, transparent); color: var(--ink); font-size: 15px; font-weight: 800; letter-spacing: .035em; line-height: 1; pointer-events: none; }
  .winner-card { position: absolute; z-index: 5; top: 50%; left: 50%; width: min(360px, calc(100% - 40px)); padding: 18px; display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 12px; border: 1px solid var(--line-strong); border-top: 3px solid var(--green); border-radius: 8px; background: color-mix(in srgb, var(--panel) 94%, transparent); box-shadow: var(--shadow); transform: translate(-50%, -50%); backdrop-filter: blur(5px); }
  .winner-trophy { font-size: 30px; line-height: 1; }
  .winner-card img { width: 58px; height: 58px; border: 2px solid var(--green); border-radius: 50%; background: var(--paper-2); object-fit: cover; }
  .winner-card div { min-width: 0; }
  .winner-card small, .winner-card strong, .winner-card div > span { display: block; }
  .winner-card small { color: var(--green); font-size: 8px; letter-spacing: .12em; }
  .winner-card strong { margin-top: 3px; overflow: hidden; font-family: var(--display); font-size: 20px; text-overflow: ellipsis; white-space: nowrap; }
  .winner-card div > span { margin-top: 2px; color: var(--muted); font-size: 8px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .is-unavailable .battle-field::after { content: 'WebGL 2 is unavailable in this browser.'; position: absolute; inset: 0; z-index: 8; display: grid; place-items: center; color: var(--muted); background: var(--paper-2); font-size: 11px; }
  :global(:root[data-theme='dark']) .battle-arena {
    --contribution-none: #161b22;
    --contribution-one: #0e4429;
    --contribution-two: #006d32;
    --contribution-three: #26a641;
    --contribution-four: #39d353;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .battle-arena {
      --contribution-none: #161b22;
      --contribution-one: #0e4429;
      --contribution-two: #006d32;
      --contribution-three: #26a641;
      --contribution-four: #39d353;
    }
  }
  @media (max-width: 640px) {
    .base-hud-layer :global(.base-hud) { transform: translate(-23px, -50%) scale(.68); transform-origin: 23px center; }
    .base-hud-layer :global(.base-hud.is-right) { transform: translate(calc(-100% + 23px), -50%) scale(.68); transform-origin: calc(100% - 23px) center; }
    .battle-watermark { top: 9px; right: 9px; font-size: 10px; }
    .winner-card { padding: 12px; grid-template-columns: auto auto 1fr; gap: 8px; }
    .winner-trophy { font-size: 22px; }
    .winner-card img { width: 42px; height: 42px; }
    .winner-card strong { font-size: 15px; }
  }
</style>
