{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static GitRacer: prerendered pages in ./dist plus a tiny router (worker/index.js).
  // No D1, R2, KV, secrets or outbound fetches.
  "name": "gitracer",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "gitracer.io", "custom_domain": true },
    { "pattern": "www.gitracer.io", "custom_domain": true }
  ],
  "env": {
    // `wrangler deploy --env preview`: a separate Worker on workers.dev for checks before cutover.
    "preview": {
      "name": "gitracer-static",
      "workers_dev": true,
      "routes": []
    }
  }
}
