# Server-side GitHub credential. Fine-grained token only needs read access to public repositories.
GITHUB_TOKEN=

# Random secret used to hash request IPs before short-lived abuse-control storage.
RATE_LIMIT_SECRET=

# Public PostHog project token. Enable "Cookieless server hash mode" in that project.
POSTHOG_KEY=
POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_INGEST_HOST=https://eu.i.posthog.com
POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
